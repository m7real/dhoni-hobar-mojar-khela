# Copy to .env for local overrides, or set these as environment variables.
# Nothing here is a secret; they are all optional.

# HTTP and WebSocket port.
PORT=3000

# Where saved games are written. Point this at a mounted disk in production.
STORE_DIR=./data/rooms

# Restrict which origins may connect, comma separated.
# Unset means any origin, which is fine locally but not on the internet.
# ALLOWED_ORIGIN=https://your-app.onrender.com

# A game ends on this many rounds, with the richest player winning.
MAX_ROUNDS=200

# How long a dropped player has to reclaim their seat, in milliseconds.
RESUME_GRACE_MS=60000

# Set to production in deployed environments.
NODE_ENV=development