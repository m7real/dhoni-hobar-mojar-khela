# Configuration for Dhoni Hobar Mojar Khela.
#
# Install to /etc/dhoni-hobar-mojar-khela.env and edit, then:
#   sudo systemctl restart dhoni-hobar-mojar-khela
#
# This file is owned by root and must be KEY=value, one per line. No quotes,
# no variable expansion.

# The port the game listens on. Keep this in step with the port you open in
# Zendevz Elastic Edge.
PORT=3000

# production enables static file caching and quiets the ordinary logs.
# Warnings are never suppressed.
NODE_ENV=production

# Where finished games are saved. This directory must be writable and is the
# only path the service is allowed to write to.
STORE_DIR=/opt/dhoni-hobar-mojar-khela/data/rooms

# REPLACE THIS with your own Zendevz subdomain, once you have it.
# Unset means any origin is accepted, which is fine while you are testing and
# wrong once the game is on the internet.
ALLOWED_ORIGIN=https://REPLACE-ME.zendevz.com

# A Monopoly game has no natural ending: once every title is sold, the START
# salary keeps compounding until rent can no longer bankrupt anybody. So games
# also end after this many rounds, with the richest player winning. Most games
# finish earlier through bankruptcy.
MAX_ROUNDS=200

# How long a player who loses connection has to reclaim their seat, in ms.
# The default is one minute.
RESUME_GRACE_MS=60000